{{!
    @template local_quizanon/searchbar

    This template will render a search bar.

    Example context (json):
    {
    }

}}
<div class="local-quizanon-gradesettings-form-search-container">
    <div class="input-group">
        <input
            type="text"
            id="searchinput-anon"
            class="form-control"
            size="6"
            maxlength="6"
            placeholder="{{#str}} search {{/str}}"
            name="hook"
            data-region="input"
            autocomplete="off"
        >
        <button id="searchbutton-anon" class="btn btn-primary">
            <i class="icon fa fa-search fa-fw" aria-hidden="true"></i>
            <span class="visually-hidden">{{#str}} search {{/str}}</span>
        </button>
    </div>
    <div id="error-search-anon" class="form-control-feedback invalid-feedback"></div>
</div>
